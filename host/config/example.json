{
  "$schema": "./schema.json",
  "version": 2,
  "device": {
    "port": "auto",
    "brightness": 200,
    "fps": 30
  },
  "palettes": {
    "sunset": {
      "label": "Sunset",
      "stops": [
        {
          "pos": 0.0,
          "color": "2b0a3d"
        },
        {
          "pos": 0.45,
          "color": "d1495b"
        },
        {
          "pos": 0.75,
          "color": "ff9505"
        },
        {
          "pos": 1.0,
          "color": "ffd60a"
        }
      ]
    }
  },
  "active_profile": "default",
  "profiles": {
    "default": {
      "label": "Everyday",
      "keys": [
        {
          "index": 0,
          "label": "Slack",
          "color": "47a2d6",
          "on": {
            "press": {
              "launch": "Slack"
            }
          },
          "watch": {
            "type": "slack_unread",
            "flash": "e01e5a"
          }
        },
        {
          "index": 1,
          "label": "Zoom",
          "color": "5c9ddc",
          "on": {
            "press": {
              "launch": "zoom.us"
            }
          }
        },
        {
          "index": 2,
          "label": "WhatsApp",
          "color": "6f98df",
          "on": {
            "press": {
              "launch": "WhatsApp"
            }
          },
          "watch": {
            "type": "unread_badge",
            "app": "WhatsApp",
            "flash": "25d366"
          }
        },
        {
          "index": 3,
          "label": "Messages",
          "color": "8193df",
          "on": {
            "press": {
              "launch": "Messages"
            }
          }
        },
        {
          "index": 4,
          "label": "Chrome Work",
          "color": "c68a41",
          "on": {
            "press": {
              "shell": "open -na 'Google Chrome' --args --profile-directory='Default'"
            }
          }
        },
        {
          "index": 5,
          "label": "Chrome Personal",
          "color": "bc903a",
          "on": {
            "press": {
              "shell": "open -na 'Google Chrome' --args --profile-directory='Profile 1'"
            }
          }
        },
        {
          "index": 6,
          "label": "Media",
          "color": "62ac70",
          "on": {
            "press": {
              "mode": "media"
            }
          }
        },
        {
          "index": 7,
          "label": "Desk",
          "color": "4cae81",
          "on": {
            "press": {
              "mode": "desk"
            }
          }
        },
        {
          "index": 8,
          "label": "Screenshot",
          "color": "9c8ad8",
          "on": {
            "press": {
              "shortcut": "cmd+shift+4",
              "flash": "ffffff"
            },
            "hold": {
              "shortcut": "cmd+shift+5"
            }
          }
        },
        {
          "index": 9,
          "label": "Do Not Disturb",
          "color": "aa85d0",
          "on": {
            "press": {
              "applescript": "tell application \"System Events\" to keystroke \"d\" using {command down, shift down}",
              "flash": "c1121f"
            }
          }
        },
        {
          "index": 10,
          "label": "Deploy",
          "color": "d67a7c",
          "on": {
            "press": {
              "script": "~/bin/deploy.sh",
              "flash": "06d6a0"
            },
            "double": {
              "shell": "open https://vercel.com/dashboard"
            }
          }
        },
        {
          "index": 11,
          "label": "Sign-off",
          "color": "d67c6c",
          "on": {
            "press": {
              "text": "Thanks!\nBill"
            }
          }
        },
        {
          "index": 12,
          "label": "Next profile",
          "color": "05adb4",
          "on": {
            "press": {
              "action": "profile_next",
              "flash": "ffffff"
            }
          }
        }
      ],
      "encoder": {
        "cw": {
          "action": "vol_up"
        },
        "ccw": {
          "action": "vol_down"
        },
        "press": {
          "action": "play_pause"
        }
      },
      "rear": {
        "press": {
          "action": "reload_config"
        }
      },
      "modes": {
        "media": {
          "activate_key": 6,
          "flash": "00ff88",
          "encoder": {
            "cw": {
              "action": "vol_up"
            },
            "ccw": {
              "action": "vol_down"
            },
            "press": {
              "action": "play_pause"
            }
          },
          "timeout_s": 8
        },
        "desk": {
          "activate_key": 7,
          "flash": "ff8800",
          "encoder": {
            "cw": {
              "action": "desk_up"
            },
            "ccw": {
              "action": "desk_down"
            },
            "press": {
              "action": "stand_sit"
            }
          },
          "timeout_s": 8
        }
      },
      "lighting": {
        "effect": {
          "name": "gradient",
          "palette": "sunset",
          "target": "underglow",
          "direction": "ring",
          "speed": 0.15
        },
        "underglow": "243954"
      }
    },
    "coding": {
      "label": "Claude Code",
      "auto_activate_app": "Terminal",
      "keys": [
        {
          "index": 0,
          "label": "Approve",
          "color": "06d6a0",
          "on": {
            "press": {
              "shortcut": "shift+tab",
              "flash": "06d6a0"
            }
          }
        },
        {
          "index": 1,
          "label": "Deny",
          "color": "e63946",
          "on": {
            "press": {
              "shortcut": "escape",
              "flash": "e63946"
            }
          }
        }
      ],
      "encoder": {
        "cw": {
          "action": "bright_up"
        },
        "ccw": {
          "action": "bright_down"
        }
      },
      "lighting": {
        "effect": {
          "name": "breathe",
          "palette": "ocean",
          "target": "underglow",
          "speed": 0.2
        }
      }
    }
  },
  "power": {
    "idle_dim_after_s": 120,
    "dim_brightness": 40,
    "idle_off_after_s": 600,
    "deep_sleep_after_s": 1800,
    "on_battery": {
      "idle_dim_after_s": 30,
      "idle_off_after_s": 120,
      "deep_sleep_after_s": 600,
      "brightness": 120
    },
    "power_button": "rear",
    "power_off_hold_ms": 2000
  },
  "webui": {
    "enabled": true,
    "host": "127.0.0.1",
    "port": 8777
  }
}